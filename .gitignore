# dependencies / build output
node_modules/
.next/
dist/
build/
out/
target/
*.class
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# secrets  —  NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key

# terraform: state can contain resource secrets in plaintext
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Lambda zips built by the archive provider at plan time
infra/terraform/*/.build/

# local tooling
.DS_Store
.idea/
.vscode/
.m2/
.npm-cache/
*.log

# TypeScript incremental build cache
*.tsbuildinfo

# load-test generated seed IDs (regenerated by loadtest/seed.py each run)
backend/loadtest/.ids.txt
