APP_ENV=development
DATABASE_URL=postgresql+psycopg://stockroom:stockroom@db:5432/stockroom
CORS_ORIGINS=http://localhost:3000
AWS_REGION=us-east-1
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
RECEIPT_BUCKET_NAME=
MAX_RECEIPT_SIZE_BYTES=10485760

# Procurement agent: unset AGENT_PROVIDER leaves it off (endpoint answers 503).
# gemini needs a free key from https://aistudio.google.com/apikey, no card required.
AGENT_PROVIDER=
GEMINI_API_KEY=
AGENT_MODEL=gemini-2.0-flash
# AGENT_PROVIDER=ollama    # local model instead, no key at all
# OLLAMA_BASE_URL=http://localhost:11434
